#!/usr/bin/env bash
set -u

VERSION="1.1.1"
APP_NAME="Downix"
APP_HOME="${DOWNIX_HOME:-$HOME/.local/share/downix}"
VENV_DIR="$APP_HOME/venv"
YTDLP="$VENV_DIR/bin/yt-dlp"
DENO_BIN="$APP_HOME/deno/bin/deno"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/downix"
LANG_FILE="$CONFIG_DIR/language"

RESET='\033[0m'; BOLD='\033[1m'; DIM='\033[2m'
GREEN='\033[38;5;46m'; CYAN='\033[38;5;51m'; YELLOW='\033[38;5;226m'; RED='\033[38;5;196m'

is_termux() {
  [[ -n "${TERMUX_VERSION:-}" ]] || [[ "${PREFIX:-}" == *"com.termux"* ]]
}

if is_termux; then
  DOWNLOAD_ROOT="$HOME/storage/shared/Download/Downix"
else
  if [[ -d "$HOME/Downloads" ]]; then
    DOWNLOAD_ROOT="$HOME/Downloads/Downix"
  else
    DOWNLOAD_ROOT="$HOME/Download/Downix"
  fi
fi
MUSIC_DIR="$DOWNLOAD_ROOT/Music"
VIDEO_DIR="$DOWNLOAD_ROOT/Video"

mkdir -p "$CONFIG_DIR" "$MUSIC_DIR" "$VIDEO_DIR" 2>/dev/null || true

load_lang() {
  if [[ -f "$LANG_FILE" ]]; then
    LANG=$(cat "$LANG_FILE" 2>/dev/null || printf 'es')
  else
    case "${LANG:-${LC_ALL:-${LC_MESSAGES:-}}}" in
      en*|EN*) LANG="en" ;;
      *) LANG="es" ;;
    esac
  fi
}

save_lang() { printf '%s\n' "$LANG" > "$LANG_FILE"; }

trmsg() {
  local key="$1"
  if [[ "$LANG" == "en" ]]; then
    case "$key" in
      audio) printf 'Download MP3 audio' ;; video) printf 'Download MP4 video' ;;
      browse) printf 'Browse downloaded files' ;; update) printf 'Update dependencies' ;;
      language) printf 'Change language' ;; exit) printf 'Exit' ;;
      paste) printf 'Paste the YouTube, Instagram, Facebook or Pinterest link:' ;;
      url) printf 'URL' ;; saving) printf 'Saving to' ;; audioq) printf 'MP3 audio quality:' ;;
      videoq) printf 'Maximum video quality:' ;; best) printf 'Best available' ;;
      failed) printf 'Download failed.' ;; retrying) printf 'Detected a yt-dlp/YouTube compatibility problem. Updating Downix runtime and retrying once...' ;;
      success) printf 'Download completed.' ;; press) printf 'Press Enter to continue...' ;;
      depsok) printf 'Dependencies are ready.' ;; depsfail) printf 'Could not update one or more dependencies.' ;;
      missing) printf 'Downix runtime is missing or damaged. Run: ./install.sh (from the project folder) or reinstall Downix.' ;;
      choose) printf 'Choose an option' ;; openfail) printf 'Could not open the file explorer automatically.' ;;
      langnow) printf 'Language changed to English.' ;;
    esac
  else
    case "$key" in
      audio) printf 'Descargar audio MP3' ;; video) printf 'Descargar video MP4' ;;
      browse) printf 'Explorar archivos descargados' ;; update) printf 'Actualizar dependencias' ;;
      language) printf 'Cambiar idioma' ;; exit) printf 'Salir' ;;
      paste) printf 'Pega el enlace de YouTube, Instagram, Facebook o Pinterest:' ;;
      url) printf 'URL' ;; saving) printf 'Guardando en' ;; audioq) printf 'Calidad de audio MP3:' ;;
      videoq) printf 'Calidad máxima de video:' ;; best) printf 'Mejor disponible' ;;
      failed) printf 'No se pudo descargar.' ;; retrying) printf 'Se detectó un problema de compatibilidad de yt-dlp/YouTube. Actualizando el runtime de Downix y reintentando una vez...' ;;
      success) printf 'Descarga completada.' ;; press) printf 'Presiona Enter para continuar...' ;;
      depsok) printf 'Dependencias listas.' ;; depsfail) printf 'No se pudo actualizar una o más dependencias.' ;;
      missing) printf 'El runtime de Downix falta o está dañado. Ejecuta ./install.sh desde la carpeta del proyecto o reinstala Downix.' ;;
      choose) printf 'Elige una opción' ;; openfail) printf 'No se pudo abrir el explorador de archivos automáticamente.' ;;
      langnow) printf 'Idioma cambiado a español.' ;;
    esac
  fi
}

clear_screen() { printf '\033[2J\033[H'; }
line() { printf '%b\n' "${DIM}  ────────────────────────────────────────────────────${RESET}"; }

banner() {
  clear_screen
  printf '%b' "$GREEN"
  cat <<'ART'
  ██████╗  ██████╗ ██╗    ██╗███╗   ██╗██╗██╗  ██╗
  ██╔══██╗██╔═══██╗██║    ██║████╗  ██║██║╚██╗██╔╝
  ██║  ██║██║   ██║██║ █╗ ██║██╔██╗ ██║██║ ╚███╔╝
  ██║  ██║██║   ██║██║███╗██║██║╚██╗██║██║ ██╔██╗
  ██████╔╝╚██████╔╝╚███╔███╔╝██║ ╚████║██║██╔╝ ██╗
  ╚═════╝  ╚═════╝  ╚══╝╚══╝ ╚═╝  ╚═══╝╚═╝╚═╝  ╚═╝
ART
  printf '%b\n' "${RESET}${DIM}            by G4brun1x  •  Media Downloader  v${VERSION}${RESET}"
  line
}

pause() { printf '\n%b' "${DIM}$(trmsg press)${RESET}"; read -r _; }

ensure_runtime() {
  if [[ ! -x "$YTDLP" ]]; then
    printf '%b\n' "${RED}✗ $(trmsg missing)${RESET}"
    return 1
  fi
  return 0
}

ytdlp_cmd() {
  local args=("$YTDLP" --ignore-config --no-playlist --newline)
  if [[ -x "$DENO_BIN" ]]; then
    args+=(--js-runtimes "deno:$DENO_BIN")
  elif command -v deno >/dev/null 2>&1; then
    args+=(--js-runtimes deno)
  fi
  args+=("$@")
  "${args[@]}"
}

runtime_update() {
  local updater="$APP_HOME/update-runtime"
  if [[ -x "$updater" ]]; then
    "$updater"
    return $?
  fi
  if [[ -x "$VENV_DIR/bin/python" ]]; then
    "$VENV_DIR/bin/python" -m pip install -U "yt-dlp[default]" || return 1
  else
    return 1
  fi
  if [[ -x "$DENO_BIN" ]]; then "$DENO_BIN" upgrade >/dev/null 2>&1 || true; fi
}

run_with_self_heal() {
  local log rc
  log=$(mktemp "${TMPDIR:-/tmp}/downix.XXXXXX") || return 1
  set +e
  ytdlp_cmd "$@" 2>&1 | tee "$log"
  rc=${PIPESTATUS[0]}
  set -e 2>/dev/null || true
  if (( rc != 0 )) && grep -Eqi 'nsig extraction failed|Unable to extract uploader id|Precondition check failed|No supported JavaScript runtime|yt-dlp-ejs|challenge solver|signature extraction failed' "$log"; then
    printf '\n%b\n' "${YELLOW}⚠ $(trmsg retrying)${RESET}"
    if runtime_update; then
      printf '\n'
      set +e
      ytdlp_cmd "$@"
      rc=$?
      set -e 2>/dev/null || true
    fi
  fi
  rm -f "$log"
  return "$rc"
}

ask_url() {
  printf '%s\n' "$(trmsg paste)"
  printf '  %s: ' "$(trmsg url)"
  read -r URL
  [[ "$URL" =~ ^https?:// ]] || { printf '%b\n' "${RED}✗ URL inválida / Invalid URL${RESET}"; return 1; }
}

download_audio() {
  ensure_runtime || { pause; return; }
  banner
  ask_url || { pause; return; }
  printf '\n%s: %s\n\n' "$(trmsg saving)" "$MUSIC_DIR"
  printf '%s\n' "$(trmsg audioq)"
  printf '  1) 128 kbps\n  2) 192 kbps\n  3) 256 kbps\n  4) 320 kbps\n  [4]: '
  read -r q; q=${q:-4}
  case "$q" in 1) abr=128 ;; 2) abr=192 ;; 3) abr=256 ;; *) abr=320 ;; esac

  if run_with_self_heal \
      -x --audio-format mp3 --audio-quality "${abr}K" \
      --embed-thumbnail --embed-metadata \
      --convert-thumbnails jpg \
      -o "$MUSIC_DIR/%(title).180B [%(id)s].%(ext)s" \
      "$URL"; then
    printf '\n%b\n' "${GREEN}✓ $(trmsg success)${RESET}"
  else
    printf '\n%b\n' "${RED}✗ $(trmsg failed)${RESET}"
    printf '%b\n' "${DIM}Algunos enlaces privados, restringidos por edad o sesión pueden requerir cookies.${RESET}"
  fi
  pause
}

download_video() {
  ensure_runtime || { pause; return; }
  banner
  ask_url || { pause; return; }
  printf '\n%s: %s\n\n' "$(trmsg saving)" "$VIDEO_DIR"
  printf '%s\n' "$(trmsg videoq)"
  printf '  1) 2160p (4K)\n  2) 1440p\n  3) 1080p\n  4) 720p\n  5) 480p\n  6) %s\n  [3]: ' "$(trmsg best)"
  read -r q; q=${q:-3}
  case "$q" in
    1) h=2160 ;; 2) h=1440 ;; 3) h=1080 ;; 4) h=720 ;; 5) h=480 ;; 6) h="" ;; *) h=1080 ;;
  esac

  local fmt
  if [[ -n "$h" ]]; then
    fmt="bv*[height<=${h}]+ba/b[height<=${h}]/b"
  else
    fmt="bv*+ba/b"
  fi

  if run_with_self_heal \
      -f "$fmt" --merge-output-format mp4 \
      --embed-metadata --embed-thumbnail \
      -o "$VIDEO_DIR/%(title).180B [%(id)s].%(ext)s" \
      "$URL"; then
    printf '\n%b\n' "${GREEN}✓ $(trmsg success)${RESET}"
  else
    printf '\n%b\n' "${RED}✗ $(trmsg failed)${RESET}"
    printf '%b\n' "${DIM}Algunos enlaces privados, restringidos por edad o sesión pueden requerir cookies.${RESET}"
  fi
  pause
}

browse_downloads() {
  mkdir -p "$DOWNLOAD_ROOT"
  if is_termux; then
    if command -v termux-open >/dev/null 2>&1; then
      termux-open "$DOWNLOAD_ROOT" >/dev/null 2>&1 || true
    elif command -v am >/dev/null 2>&1; then
      am start -a android.intent.action.VIEW -d "file://$DOWNLOAD_ROOT" >/dev/null 2>&1 || true
    else
      printf '%b\n' "${YELLOW}! $(trmsg openfail)${RESET}"
      printf '%s\n' "$DOWNLOAD_ROOT"
    fi
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$DOWNLOAD_ROOT" >/dev/null 2>&1 &
  elif command -v gio >/dev/null 2>&1; then
    gio open "$DOWNLOAD_ROOT" >/dev/null 2>&1 &
  else
    printf '%s\n' "$DOWNLOAD_ROOT"
  fi
  pause
}

update_dependencies() {
  banner
  printf '%b\n\n' "${CYAN}$(trmsg update)...${RESET}"
  if runtime_update; then
    printf '\n%b\n' "${GREEN}✓ $(trmsg depsok)${RESET}"
    printf '%b\n' "${DIM}yt-dlp: $($YTDLP --version 2>/dev/null || printf '?')${RESET}"
    if [[ -x "$DENO_BIN" ]]; then printf '%b\n' "${DIM}$($DENO_BIN --version 2>/dev/null | head -n1)${RESET}"; fi
    command -v ffmpeg >/dev/null 2>&1 && printf '%b\n' "${DIM}$(ffmpeg -version 2>/dev/null | head -n1)${RESET}"
  else
    printf '%b\n' "${RED}✗ $(trmsg depsfail)${RESET}"
  fi
  pause
}

change_language() {
  if [[ "$LANG" == "es" ]]; then LANG="en"; else LANG="es"; fi
  save_lang
  printf '%b\n' "${GREEN}✓ $(trmsg langnow)${RESET}"
  sleep 1
}

show_menu() {
  while true; do
    load_lang
    banner
    printf '  %b[1]%b %s\n' "$GREEN" "$RESET" "$(trmsg audio)"
    printf '  %b[2]%b %s\n' "$GREEN" "$RESET" "$(trmsg video)"
    printf '  %b[3]%b %s\n' "$GREEN" "$RESET" "$(trmsg browse)"
    printf '  %b[4]%b %s\n' "$GREEN" "$RESET" "$(trmsg update)"
    printf '  %b[5]%b %s\n' "$GREEN" "$RESET" "$(trmsg language)"
    printf '  %b[0]%b %s\n' "$RED" "$RESET" "$(trmsg exit)"
    line
    printf '  > '
    read -r opt
    case "$opt" in
      1) download_audio ;;
      2) download_video ;;
      3) browse_downloads ;;
      4) update_dependencies ;;
      5) change_language ;;
      0) clear_screen; exit 0 ;;
      *) sleep 0.5 ;;
    esac
  done
}

case "${1:-}" in
  --version|-v) printf 'Downix %s\n' "$VERSION" ;;
  --update) load_lang; runtime_update ;;
  '') load_lang; show_menu ;;
  *) printf 'Usage: down [--version|--update]\n'; exit 2 ;;
esac
